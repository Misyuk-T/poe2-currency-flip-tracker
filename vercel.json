{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build apps/web",
  "outputDirectory": "apps/web/.next",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "poe2-currency-flip-tracker.vercel.app" }],
      "destination": "https://exileradar.com/:path",
      "permanent": true
    }
  ]
}
